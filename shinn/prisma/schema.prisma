// SHINN — locked schema. See project design doc for full rationale.
// Do not add product data sources outside this schema (no Sheets, no JSON,
// no hardcoded arrays) — this file + its migrations are the single source
// of truth, per architecture rule 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id     String @id @default(cuid())
  sku    String @unique
  slug   String @unique

  nameEn        String
  nameKm        String
  descriptionEn String?
  descriptionKm String?

  seoTitleEn       String?
  seoTitleKm       String?
  seoDescriptionEn String?
  seoDescriptionKm String?

  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  status         ProductStatus @default(DRAFT)
  visibility     Boolean       @default(true)
  gender         Gender?
  department     String?

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images   ProductImage[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, visibility])
  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size          String?
  color         String?
  sku           String   @unique // server-generated only — never admin-entered, see lib/services/sku.ts
  stock         Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2) // null = use Product.price

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  // NOTE: uniqueness on (productId, size, color) is enforced via a NULL-safe
  // COALESCE partial unique index added by hand in
  // prisma/migrations/00000000000000_init/migration.sql — Prisma's @@unique
  // treats NULL != NULL, which would NOT stop two "no size / no color"
  // variants on the same product. Do not add a plain @@unique here.
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  altEn    String?
  altKm    String?
  isMain   Boolean @default(false)
  position Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([productId, position])
  @@index([productId])
  // NOTE: "at most one isMain=true per product" is enforced via a partial
  // unique index (WHERE "isMain" = true) added by hand in the init
  // migration — not expressible via Prisma's @@unique DSL.
}

model Brand {
  id     String @id @default(cuid())
  nameEn String
  nameKm String
  slug   String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id     String @id @default(cuid())
  nameEn String
  nameKm String
  slug   String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  role         Role   @default(CUSTOMER)

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique // SHA-256 hash of the raw token; raw token is never stored

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum Role {
  ADMIN
  CUSTOMER
}
